# Template de configuration — CE fichier est commité, le .env ne l'est jamais.
#
#   cp .env.example .env   puis renseigner ses propres valeurs
#
# Toute variable listée ici sans valeur par défaut dans le code est obligatoire :
# la retirer fait échouer le démarrage avec un message qui la nomme.

NODE_ENV=production

# --- API Node.js -------------------------------------------------------------
# PORT : port d'écoute À L'INTÉRIEUR du conteneur.
# API_PORT : port publié sur la machine hôte. Les deux sont distincts exprès —
# changer le port publié ne doit jamais demander de rebuild de l'image.
PORT=3000
API_PORT=3000

# --- PostgreSQL --------------------------------------------------------------
# DB_HOST vaut le NOM DU SERVICE déclaré dans docker-compose.yml, pas une IP :
# c'est le DNS interne du network custom qui le résout.
# Ces cinq clés sont lues à l'identique par l'API Node.js et par stats-api.
DB_HOST=db
DB_PORT=5432
DB_NAME=todo_db
DB_USER=todo_user
DB_PASSWORD=change_me

# --- Services annexes --------------------------------------------------------
ADMINER_PORT=8080
STATS_PORT=8000

# --- Registry (chapitre 9) ---------------------------------------------------
# Utilise uniquement par docker-compose.prod.yml, qui tire les images publiees
# au lieu de les construire. Changer de registry = changer cette seule ligne.
#   localhost:5000/gabrielsaint-louis  -> registry prive local
#   gabrielsaint-louis                 -> Docker Hub
#   ghcr.io/gabrielsaint-louis         -> GitHub Container Registry
IMAGE_PREFIX=localhost:5000/gabrielsaint-louis
IMAGE_TAG=1.0.0
