# Le contrat de configuration de la flotte. Ce fichier est commite, jamais le
# .env reel : il sert de liste de courses a qui remonte la flotte ailleurs.
#
#   cp .env.example .env   puis on remplit, et .env reste sur la machine.

# --- Ce que le tableau de la classe attend -----------------------------------
# L'adresse du tableau, communiquee par le formateur le matin. Sans elle les
# services demarrent quand meme, mais ils le disent dans leurs logs et aucun
# carre ne s'allume.
TABLEAU_URL=
GROUPE=Mugiwarabe
COULEUR=#8B4513

# --- Ce que la pipeline ecrit elle-meme sur la machine cible ------------------
# REGISTRY et TAG ne se remplissent pas a la main en production : le job de
# deploiement les ecrit avec le sha du commit. Les valeurs ci-dessous ne servent
# qu'a monter la flotte en local.
REGISTRY=ghcr.io/gabrielsaint-louis
TAG=dev

# --- La base ------------------------------------------------------------------
# En production, ce mot de passe vient des secrets du repo. Ici, une valeur
# bidon : si vous lisez un vrai mot de passe dans ce fichier, c'est un incident.
DB_PASSWORD=motdepasse-de-developpement
DB_NAME=grandline
DB_USER=postgres

# --- Le service vigie ---------------------------------------------------------
# La cle du modele externe. Absente, la vigie demarre quand meme et se rabat sur
# sa banque de questions locale : un service annexe qui refuse de demarrer parce
# qu'un tiers ne repond pas eteindrait un carre pour rien.
GROQ_API_KEY=
