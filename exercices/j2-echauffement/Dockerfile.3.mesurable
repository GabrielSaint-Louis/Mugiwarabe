# Le fichier 3 d'origine ne va pas jusqu'au bout : `npm run build` n'existe pas
# dans ce projet. Cette variante ne sert qu'a repondre a la question posee
# (« pourquoi l'image depasse le Go ? ») : elle retire l'etape de build et rien
# d'autre, pour que la taille soit mesurable et comparable.
FROM node:18
WORKDIR /app
COPY . .
RUN npm install
EXPOSE 3000
CMD ["node", "src/server.js"]
