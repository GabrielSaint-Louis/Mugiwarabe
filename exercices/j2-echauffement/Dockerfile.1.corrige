# Correction du fichier 1. Deux defauts, deux corrections.
#
#  1. COPY package.json ./  ->  COPY package.json package-lock.json ./
#     Sans le lock file, `npm install` reresout l'arbre de dependances a chaque
#     build : 2 paquets sur 84 sont sortis differents de ce que le lock fige
#     (encodeurl 1.0.2 -> 2.0.0, ms 2.1.3 -> 2.0.0). `npm ci` exige le lock et
#     installe exactement ce qui y est ecrit.
#
#  2. CMD npm start  ->  CMD ["node", "src/server.js"]
#     En forme shell, c'est npm qui devient PID 1 : +19 Mio de memoire, une
#     couche de process en plus, et le code de sortie de l'app est ecrase
#     (SIGKILL 137 rapporte en 1). En forme exec, node est PID 1 et recoit le
#     SIGTERM de `docker stop` directement.
FROM node:18-alpine
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
COPY src ./src
EXPOSE 3000
CMD ["node", "src/server.js"]
