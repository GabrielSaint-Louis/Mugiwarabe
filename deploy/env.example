# Modele du .env de production. CE fichier est commite, celui de la machine
# cible ne l'est jamais.
#
# Il se copie une seule fois a la main, au moment de preparer la machine :
#
#   scp -i deploy/deploy_key -P 2222 deploy/env.example root@127.0.0.1:/srv/todo/.env
#   ssh -i deploy/deploy_key -p 2222 root@127.0.0.1 'vi /srv/todo/.env'   # vrai mot de passe
#
# Ensuite il ne bouge plus. La pipeline ne le remplace pas a chaque
# deploiement : elle envoie le compose.yml et rien d'autre. Un secret qui
# transite a chaque push est un secret qui finit dans un log le jour ou une
# commande est mal ecrite.

# --- Base de donnees ---------------------------------------------------------
# Ces trois valeurs sont lues DEUX fois : par l'image postgres, qui cree la base
# et l'utilisateur a son premier demarrage, et par l'API, qui s'y connecte.
# Elles doivent donc etre identiques des deux cotes, d'ou le fichier unique.
DB_NAME=todo_db
DB_USER=todo_user
DB_PASSWORD=a_remplacer_par_un_vrai_mot_de_passe

# DB_PORT a une valeur par defaut dans src/config.js. DB_HOST n'est pas ici :
# il vaut le nom du service (todo-db) et vit dans compose.yml, parce que c'est
# une constante de topologie et pas un secret.
DB_PORT=5432

# --- Grafana (phase 8) -------------------------------------------------------
# L'image grafana demarre sur admin/admin, un couple connu de la Terre entiere.
# Cette variable le remplace des le premier demarrage.
GRAFANA_ADMIN_PASSWORD=a_remplacer_aussi

# --- Note sur le premier demarrage -------------------------------------------
# L'image postgres ne cree la base et l'utilisateur qu'au TOUT PREMIER
# demarrage, quand le volume est vide. Changer DB_PASSWORD ici apres coup ne
# change rien dans la base deja initialisee : l'API se retrouve alors avec un
# mot de passe que Postgres refuse, et repond 503. C'est une des pannes
# repertoriees dans docs/PROCEDURE_DEPLOIEMENT.md.
