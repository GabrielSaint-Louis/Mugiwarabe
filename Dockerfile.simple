# Le brouillon : celui qui "marche sur ma machine".
# Conserve volontairement dans le depot comme point de comparaison pour le
# tableau de metriques du chapitre 10. Il cumule les quatre defauts classiques :
#   1. tag flottant (node:20-alpine) : l'image de base peut changer sous nos pieds
#   2. COPY . . avant l'install : le moindre commit invalide le cache de npm
#   3. npm install (et pas npm ci --omit=dev) : versions qui derivent, deps de dev embarquees
#   4. aucun USER : le process tourne en root dans le conteneur
FROM node:20-alpine
WORKDIR /app
COPY . .
RUN npm install
EXPOSE 3000
CMD ["node", "src/server.js"]
