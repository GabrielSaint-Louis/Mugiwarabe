node_modules/
npm-debug.log*

# La configuration reelle ne part jamais dans le depot : seul .env.example est
# commite (chapitre 7).
.env
.env.local

# --- Jour 3, phase 2 : la cle de deploiement ---------------------------------
# Ces deux lignes s'ecrivent AVANT le premier `git add` de la phase, jamais
# apres. Une cle privee poussee par erreur ne se rattrape pas avec un commit de
# suppression : elle reste dans l'historique, et `git log -p` la retrouve.
# Seule la cle PUBLIQUE (deploy_key.pub) est commitee, c'est son role.
deploy/deploy_key
deploy_key
*.pem

# Le runner self-hosted s'installe a cote du depot, mais si quelqu'un le pose
# dedans, son jeton d'enregistrement ne doit pas partir avec.
actions-runner/

# --- Jour 4, phase 2 : le Secret du cluster ----------------------------------
# Seul k8s/todo-secret.example.yaml est commite, avec des valeurs bidon. Le
# fichier reel porte le mot de passe de la base en clair (stringData), il reste
# sur la machine.
k8s/todo-secret.yaml

# --- Jour 4, phase 5 : le kubeconfig -----------------------------------------
# Un kubeconfig committe donne les pleins pouvoirs sur le cluster a quiconque
# le lit. Il vit dans ~/.kube/config, jamais ici.
kubeconfig
*.kubeconfig

# --- Jour 4, phase 10 : la reponse de chaos.sh -------------------------------
# .incident contient le numero de la panne tiree. Le committer reviendrait a
# publier le corrige avec l'exercice.
.incident

coverage/
*.log
.DS_Store

# Genere par Next a la construction, jamais commite.
.next/
next-env.d.ts
k8s/02-secret.yaml
